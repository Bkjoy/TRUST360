# Deposit360 Frontend Production Environment Variables
# When deploying to Vercel, set VITE_API_URL in Vercel Project Settings -> Environment Variables.
# Example: https://deposit360-api.onrender.com
# Note: Do not include trailing slashes or subpaths unless desired; Deposit360 automatically handles /api/v1.
VITE_API_URL=https://your-backend.onrender.com
